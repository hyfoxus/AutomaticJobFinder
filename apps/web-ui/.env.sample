# Copy this file to ".env" to override defaults. Every value below is optional.

# The published port is read by docker compose, not by the service. Set UI_HTTP_PORT (default 8084)
# in your shell, or in the file passed with --env-file. It is published on 127.0.0.1 only.

# The UI is off until you turn it on. Scoring must be enabled too: the pages are built from its REST API.
UI_ENABLED=false
# Host names the UI answers to (a bare name, no port). Anything else gets 403.
# UI_ALLOWED_HOSTS=localhost,127.0.0.1
