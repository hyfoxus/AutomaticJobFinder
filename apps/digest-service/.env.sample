# Copy this file to ".env" to override defaults. Every value below is optional.
# Keep real secrets here only: .env is git-ignored and never baked into an image.

# The published port is read by docker compose, not by the service. Set DIGEST_HTTP_PORT (default 8083)
# in your shell, or in the file passed with --env-file.

# The digest is off until you turn it on. Scoring must be enabled too: the digest reads its REST API.
DIGEST_ENABLED=false
# dry-run (default) writes digest-<time>.html/.txt into ./digest-out and records nothing as sent.
# smtp sends the mail and records what was sent. Switching to smtp mails everything scored in the last 7 days
# that has not been mailed (the dry-run never records anything).
DIGEST_MODE=dry-run
DIGEST_TIERS=STRONG,PARTIAL
DIGEST_MAX_ITEMS=50
# Spring cron, container time zone (UTC unless TZ is set); "-" turns the schedule off.
DIGEST_CRON=0 0 8 * * *
# TZ=Europe/Kyiv

# smtp mode needs host, from and to (to may list several addresses, comma separated).
# TLS is required (STARTTLS) unless the host is localhost/127.0.0.1/::1.
# DIGEST_SMTP_HOST=smtp.example.com
# DIGEST_SMTP_PORT=587
# DIGEST_SMTP_USERNAME=
# DIGEST_SMTP_FROM=jobs@example.com
# DIGEST_SMTP_TO=me@example.com
# Implicit TLS (usually port 465):
# DIGEST_SMTP_SSL=false
# Only for a trusted network without TLS; logs a warning:
# DIGEST_SMTP_ALLOW_PLAINTEXT=false

# The SMTP password: either here ...
# DIGEST_SMTP_PASSWORD=
# ... or, better, in the file secrets/digest/smtp_password (git-ignored), which compose mounts read-only at
# /run/secrets/smtp_password. If both are set, the variable wins.
