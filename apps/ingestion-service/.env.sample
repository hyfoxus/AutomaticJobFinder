# Copy this file to ".env" to override defaults. Every value below is optional.
# Keep real secrets outside version control.

POSTGRES_DB=jobapplier
POSTGRES_USER=jobapplier
POSTGRES_PASSWORD=jobapplier
POSTGRES_PORT=15432

INGESTION_HTTP_PORT=8081
# Remotive asks for at most about 4 fetches a day.
INGESTION_CRON=0 0 */6 * * *

# Remotive request filter. Category slug (blank = whole board); search matches title and description.
INGESTION_REMOTIVE_CATEGORY=software-dev
INGESTION_REMOTIVE_SEARCH=
