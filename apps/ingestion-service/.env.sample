# Copy this file to ".env" to override defaults. Every value below is optional.
# Keep real secrets outside version control.

POSTGRES_DB=jobapplier
POSTGRES_USER=jobapplier
POSTGRES_PASSWORD=jobapplier
POSTGRES_PORT=15432

INGESTION_HTTP_PORT=8081
# Remotive asks for at most about 4 fetches a day.
INGESTION_CRON=0 0 */6 * * *

# Remotive request filter. Category slug (blank = whole board); search matches title and description.
INGESTION_REMOTIVE_CATEGORY=software-dev
INGESTION_REMOTIVE_SEARCH=

# A recipe crawl stops after this long and keeps what it collected.
INGESTION_FETCH_MAX_RUN_DURATION=20m

# Where recipe JSON files are read from inside the container (compose mounts ./recipes there).
INGESTION_RECIPES_DIR=/app/recipes

# NOTE: docker compose fills the container environment from the ROOT .env (next to docker-compose.yml); the
# learner variables below (and INGESTION_LEARNER_MAX_CLONES / INGESTION_LEARNER_CLONE_MAX_RUN) belong there, not in
# this file.
# Recipe learner (off by default). When on, POST /api/learn {"url": "..."} asks the model for a recipe for a careers
# site and saves it, disabled, in ./recipes-proposed. Needs scoring enabled with a provider, and the secret file
# secrets/learner/token (scripts/setup.sh creates it). A host is fetched only if it is listed below; list a host only
# after you have read its terms of use and robots.txt. Comma separated, exact host names.
INGESTION_LEARNER_ENABLED=false
INGESTION_LEARNER_ALLOWED_HOSTS=
# After one recipe works, POST /api/clone {"template": "<recipe name>", "indexUrl": "<sitemap index>"} copies it to the
# sibling locales (no model call). INGESTION_LEARNER_MAX_CLONES=80 INGESTION_LEARNER_CLONE_MAX_RUN=30m
