# Copy this file to ".env" to override defaults. Every value below is optional.
# Keep real secrets (API keys) here only: .env is git-ignored and never baked into an image.

# The published port is read by docker compose, not by the service. Set SCORING_HTTP_PORT (default 8082)
# in your shell, or in the file passed with --env-file.

# Scoring is off until you turn it on and give it a provider, a model and a profile (config/profile.yml).
SCORING_ENABLED=false
# openai, anthropic or ollama
SCORING_AI_PROVIDER=none
SCORING_LLM_MODEL=
# true only for a local ollama model
SCORING_LLM_FREE=false
SCORING_BUDGET_DAILY_USD=1.00

# Provider keys, for the provider you picked:
# SPRING_AI_OPENAI_API_KEY=
# SPRING_AI_ANTHROPIC_API_KEY=
# SPRING_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model prices (USD per million tokens) have bracketed property names, so pass them as Java options:
# JAVA_OPTS=-Dscoring.llm.prices[gpt-4.1-mini].input-per-million=0.40 -Dscoring.llm.prices[gpt-4.1-mini].output-per-million=1.60

# The cron schedule and the daily budget reset follow the container time zone, which is UTC unless TZ is set.
# TZ=Europe/Kyiv
# SCORING_BUDGET_ZONE=Europe/Kyiv

# Pull schedule (Spring cron, container time zone); "-" turns it off. Run on demand with POST /api/scoring/run.
SCORING_INGESTION_CRON=0 15 */6 * * *

# Recipe-learn endpoint (POST /api/llm/complete, used only by the ingestion learner). It exists only when the file
# secrets/learner/token holds a secret of at least 16 characters (create it before "docker compose up", otherwise
# Docker makes a directory of that name). Caps, inside the shared daily budget; set them as Java options:
# JAVA_OPTS=-Dscoring.learn.daily-runs=3 -Dscoring.learn.daily-usd=0.25 -Dscoring.learn.max-tokens=2000
